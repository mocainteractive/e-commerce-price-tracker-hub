{
  "name": "moca-price-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Price tracking e-commerce per Moca Hub - monitoraggio prezzi competitor via DataForSEO",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "tsc -b --force",
    "test": "esbuild tests/unit-checks.ts --bundle --platform=node --target=node20 --format=esm --outfile=node_modules/.cache/unit-checks.mjs --log-level=warning && node node_modules/.cache/unit-checks.mjs",
    "netlify:dev": "netlify dev"
  },
  "dependencies": {
    "@supabase/supabase-js": ">=2.94.0 <2.110.0",
    "fast-xml-parser": "^4.5.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.2",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
