# =============================================================================
# Price Tracker - app integrata Moca Hub
# Copia questo file in .env.local e compila. NON committare .env.local.
#
# NOTA: le credenziali DataForSEO NON si impostano qui in produzione.
# Arrivano dalla configurazione cliente su Moca Hub (DATAFORSEO_LOGIN e
# DATAFORSEO_PASSWORD), l'SDK le consegna al frontend alla validazione del
# launch token e il frontend le inoltra alle Netlify Functions.
# =============================================================================

# --- Moca Hub -----------------------------------------------------------------
VITE_MOCA_HUB_URL=https://moca-central-hub.netlify.app

# --- Supabase (stessa istanza dell'Hub, SOLO Netlify Functions) ---------------
# Servono allo storico prezzi, alla scansione pianificata e al postback.
# MAI con prefisso VITE_: la service_role bypassa la RLS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Postback DataForSEO -------------------------------------------------------
# Protegge l'endpoint pubblico che riceve i risultati delle scansioni.
# Genera con: openssl rand -hex 32
DATAFORSEO_POSTBACK_SECRET=

# URL pubblica dell'app, usata per costruire il postback_url dei task.
APP_PUBLIC_URL=https://e-commerce-tracker-hub.netlify.app

# --- Sviluppo locale (Mock Mode) ----------------------------------------------
# Su localhost l'SDK parte in Mock Mode senza launch token.
# Chiavi di test iniettate nel mock: NON committare valori reali.
VITE_DEV_DATAFORSEO_LOGIN=
VITE_DEV_DATAFORSEO_PASSWORD=
# client_id reale su cui lavorare in locale (deve essere un UUID).
VITE_DEV_CLIENT_ID=

# Fallback per `netlify dev`, quando la scansione pianificata gira in locale
# e non puo' leggere le configurazioni dall'Hub.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
