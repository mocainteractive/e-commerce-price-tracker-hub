# =============================================================================
# Price Tracker - app integrata Moca Hub
# Copia questo file in .env.local e compila. NON committare .env.local.
# =============================================================================

# --- Moca Hub -----------------------------------------------------------------
# URL dell'Hub. Usato lato server per validare il launch token.
VITE_MOCA_HUB_URL=https://moca-central-hub.netlify.app
MOCA_HUB_URL=https://moca-central-hub.netlify.app

# --- Sessione applicativa (SOLO server-side) ----------------------------------
# Segreto con due usi: firma il JWT di sessione emesso dopo la validazione del
# launch token e, tramite HKDF, cifra le configurazioni cliente conservate in
# pt_client_credentials. Genera con: openssl rand -base64 48
# Cambiarlo invalida le sessioni attive e la copia cifrata, che viene
# rigenerata al primo accesso dall'Hub.
APP_SESSION_SECRET=

# --- Supabase (stessa istanza dell'Hub) ---------------------------------------
# SOLO Netlify Functions. MAI con prefisso VITE_: la service_role bypassa la RLS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- DataForSEO ----------------------------------------------------------------
# In produzione NON si impostano qui: le credenziali arrivano dalla
# configurazione cliente del Moca Hub (chiavi DATAFORSEO_LOGIN e
# DATAFORSEO_PASSWORD), consegnate all'app alla validazione del launch token e
# conservate cifrate lato server. Le variabili qui sotto sono solo il fallback
# per lo sviluppo locale in Mock Mode.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Segreto che protegge l'endpoint pubblico di postback di DataForSEO.
# Genera con: openssl rand -hex 32
DATAFORSEO_POSTBACK_SECRET=

# URL pubblica dell'app, usata per costruire il postback_url dei task.
APP_PUBLIC_URL=https://moca-price-tracker.netlify.app

# --- Sviluppo locale (Mock Mode) ----------------------------------------------
# Abilita la sessione mock senza launch token. MAI "true" in produzione.
MOCA_ALLOW_MOCK=true
VITE_MOCA_ALLOW_MOCK=true
# client_id reale su cui lavorare in locale (facoltativo: senza, si usa il mock).
MOCA_MOCK_CLIENT_ID=
